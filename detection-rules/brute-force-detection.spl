# Brute Force Detection
# Detects repeated failed login attempts from the same source IP
# MITRE ATT&CK: T1110 - Brute Force

index=main source="WinEventLog:Security" EventCode=4625
| stats count by src_ip, user, _time
| where count > 5
| eval alert_type="Brute Force Attempt"
| eval severity=case(count > 20, "HIGH", count > 10, "MEDIUM", true(), "LOW")
| table _time, src_ip, user, count, alert_type, severity
| sort -count
